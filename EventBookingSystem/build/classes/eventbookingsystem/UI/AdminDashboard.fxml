<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: linear-gradient(to bottom, #E3F2FD, #FFFFFF);" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eventbookingsystem.controller.AdminDashboardController">
   <top>
      <VBox spacing="10.0" style="-fx-background-color: #BBDEFB; -fx-padding: 15;">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <Label text="Administrator Dashboard" textFill="#1A237E" style="-fx-font-weight: bold;">
            <font>
               <Font size="20.0" />
            </font>
         </Label>
         <Label fx:id="welcomeLabel" text="Welcome Admin!" textFill="#263238" />
      </VBox>
   </top>

   <center>
      <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: transparent;">
         <padding>
            <Insets left="10.0" right="10.0" />
         </padding>

         <Tab text="Users">
            <VBox spacing="10.0">
               <padding>
                  <Insets top="10.0" />
               </padding>
               <TableView fx:id="usersTable" prefHeight="300.0" style="-fx-background-color: white; -fx-border-color: #BBDEFB; -fx-border-radius: 5;">
                  <columns>
                     <TableColumn fx:id="userIdColumn" text="ID" prefWidth="60.0" />
                     <TableColumn fx:id="usernameColumn" text="Username" prefWidth="120.0" />
                     <TableColumn fx:id="fullNameColumn" text="Full Name" prefWidth="150.0" />
                     <TableColumn fx:id="emailColumn" text="Email" prefWidth="150.0" />
                     <TableColumn fx:id="roleColumn" text="Role" prefWidth="100.0" />
                  </columns>
               </TableView>
            </VBox>
         </Tab>

         <Tab text="Events">
            <VBox spacing="10.0">
               <padding>
                  <Insets top="10.0" />
               </padding>
               <TableView fx:id="eventsTable" prefHeight="300.0" style="-fx-background-color: white; -fx-border-color: #BBDEFB; -fx-border-radius: 5;">
                  <columns>
                     <TableColumn fx:id="eventIdColumn" text="ID" prefWidth="60.0" />
                     <TableColumn fx:id="eventNameColumn" text="Event Name" prefWidth="180.0" />
                     <TableColumn fx:id="eventDateColumn" text="Date" prefWidth="100.0" />
                     <TableColumn fx:id="locationColumn" text="Location" prefWidth="140.0" />
                     <TableColumn fx:id="seatsColumn" text="Seats" prefWidth="80.0" />
                     <TableColumn fx:id="priceColumn" text="Price" prefWidth="80.0" />
                  </columns>
               </TableView>
            </VBox>
         </Tab>

         <Tab text="Bookings">
            <VBox spacing="10.0">
               <padding>
                  <Insets top="10.0" />
               </padding>
               <TableView fx:id="bookingsTable" prefHeight="300.0" style="-fx-background-color: white; -fx-border-color: #BBDEFB; -fx-border-radius: 5;">
                  <columns>
                     <TableColumn fx:id="bookingIdColumn" text="ID" prefWidth="80.0" />
                     <TableColumn fx:id="customerColumn" text="Customer" prefWidth="150.0" />
                     <TableColumn fx:id="eventColumn" text="Event" prefWidth="180.0" />
                     <TableColumn fx:id="dateColumn" text="Date" prefWidth="100.0" />
                     <TableColumn fx:id="ticketsColumn" text="Tickets" prefWidth="80.0" />
                  </columns>
               </TableView>
            </VBox>
         </Tab>
      </TabPane>
   </center>

   <bottom>
      <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #F5F5F5; -fx-padding: 10;">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#handleDelete" text="Delete Selected" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />

         <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#handleLogout" text="Logout" style="-fx-background-color: #64B5F6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
      </HBox>
   </bottom>
</BorderPane>
