<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: linear-gradient(to bottom, #E3F2FD, #FFFFFF);" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eventbookingsystem.controller.EventDetailsController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <Label text="Event Details" textFill="#1A237E" style="-fx-font-weight: bold;">
      <font>
         <Font size="18.0" />
      </font>
   </Label>

   <VBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #BBDEFB; -fx-border-radius: 5; -fx-background-radius: 5;">
      <HBox spacing="10.0">
         <Label text="Event Name:" textFill="#263238" style="-fx-font-weight: bold;" />
         <Label fx:id="eventNameLabel" text="" textFill="#424242" />
      </HBox>

      <HBox spacing="10.0">
         <Label text="Date:" textFill="#263238" style="-fx-font-weight: bold;" />
         <Label fx:id="eventDateLabel" text="" textFill="#424242" />
      </HBox>

      <HBox spacing="10.0">
         <Label text="Location:" textFill="#263238" style="-fx-font-weight: bold;" />
         <Label fx:id="locationLabel" text="" textFill="#424242" />
      </HBox>

      <HBox spacing="10.0">
         <Label text="Description:" textFill="#263238" style="-fx-font-weight: bold;" />
         <Label fx:id="descriptionLabel" text="" textFill="#424242" wrapText="true" prefWidth="300.0" />
      </HBox>

      <HBox spacing="10.0">
         <Label text="Seats Remaining:" textFill="#263238" style="-fx-font-weight: bold;" />
         <Label fx:id="seatsLabel" text="" textFill="#424242" />
      </HBox>

      <HBox spacing="10.0">
         <Label text="Ticket Price:" textFill="#263238" style="-fx-font-weight: bold;" />
         <Label fx:id="priceLabel" text="" textFill="#424242" />
      </HBox>
   </VBox>

   <HBox alignment="CENTER" spacing="10.0">
      <Label text="Number of Tickets:" textFill="#263238" style="-fx-font-weight: bold;" />
      <Spinner fx:id="ticketSpinner" prefWidth="100.0" editable="true" style="-fx-background-color: white; -fx-border-color: #BBDEFB; -fx-border-radius: 5;" />
   </HBox>

   <Label fx:id="messageLabel" />

   <HBox alignment="CENTER" spacing="10.0">
      <Button fx:id="bookButton" mnemonicParsing="false" onAction="#handleBook" text="Book Now" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
      <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" text="Back" style="-fx-background-color: #64B5F6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
   </HBox>
</VBox>
