<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="400.0" prefHeight="450.0" style="-fx-background-color: linear-gradient(to bottom, #E3F2FD, #FFFFFF);" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eventbookingsystem.controller.LoginController">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>

   <Label text="Event Ticket Booking" textFill="#1A237E" style="-fx-font-weight: bold;">
      <font>
         <Font size="24.0" />
      </font>
   </Label>
   <Label text="System" textFill="#1A237E" style="-fx-font-weight: bold;">
      <font>
         <Font size="24.0" />
      </font>
   </Label>
   <Label text="Login" textFill="#263238" style="-fx-font-weight: bold;">
      <font>
         <Font size="16.0" />
      </font>
   </Label>

   <VBox spacing="5.0">
      <Label text="Username:" textFill="#424242" />
      <TextField fx:id="usernameField" prefWidth="300.0" style="-fx-background-color: white; -fx-border-color: #BBDEFB; -fx-border-radius: 5; -fx-background-radius: 5;" />
   </VBox>

   <VBox spacing="5.0">
      <Label text="Password:" textFill="#424242" />
      <PasswordField fx:id="passwordField" prefWidth="300.0" style="-fx-background-color: white; -fx-border-color: #BBDEFB; -fx-border-radius: 5; -fx-background-radius: 5;" />
   </VBox>

   <Label fx:id="errorLabel" textFill="RED" />

   <Button fx:id="loginButton" mnemonicParsing="false" onAction="#handleLogin" text="Login" prefWidth="200.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
   <Button fx:id="registerButton" mnemonicParsing="false" onAction="#handleRegister" text="Register" prefWidth="200.0" style="-fx-background-color: #64B5F6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
</VBox>
