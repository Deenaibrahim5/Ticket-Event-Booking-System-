<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: linear-gradient(to bottom, #E3F2FD, #FFFFFF);" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eventbookingsystem.controller.CustomerBookingsController">
   <top>
      <VBox spacing="10.0" style="-fx-background-color: #BBDEFB; -fx-padding: 15;">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <Label text="My Bookings" textFill="#1A237E" style="-fx-font-weight: bold;">
            <font>
               <Font name="System Bold" size="20.0" />
            </font>
         </Label>
      </VBox>
   </top>

   <center>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
         </padding>
         <TableView fx:id="bookingsTable" prefHeight="350.0" style="-fx-background-color: white; -fx-border-color: #BBDEFB; -fx-border-radius: 5;">
            <columns>
               <TableColumn fx:id="bookingIdColumn" text="Booking ID" prefWidth="100.0" />
               <TableColumn fx:id="eventNameColumn" text="Event Name" prefWidth="200.0" />
               <TableColumn fx:id="bookingDateColumn" text="Booking Date" prefWidth="120.0" />
               <TableColumn fx:id="ticketsColumn" text="Tickets" prefWidth="80.0" />
            </columns>
         </TableView>
      </VBox>
   </center>

   <bottom>
      <HBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #F5F5F5; -fx-padding: 10;">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancelBooking" text="Cancel Booking" prefWidth="130.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
         <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" text="Back" prefWidth="100.0" style="-fx-background-color: #64B5F6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
      </HBox>
   </bottom>
</BorderPane>
